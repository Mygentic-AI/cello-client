# NO TRAILING SLASH, deliberately. `node_modules/` matches DIRECTORIES only, and under the iCloud
# workaround below every package's `node_modules` is a SYMLINK to `node_modules.nosync` — so the
# slashed pattern missed all of them and `git status` reported a dozen untracked entries on a clean
# checkout. That is not cosmetic: `j-canary` asserts `git status --porcelain` is empty in both repos,
# so the canary could never pass on a normal dev machine.
node_modules
# Same no-trailing-slash rule, same reason: `scripts/nosync-build-output.sh` makes every
# `core/*/dist` a SYMLINK to `dist.nosync`, and `dist/` matches directories only.
dist
dist.nosync
*.tsbuildinfo
.env
.env.*
!.env.example
core/**/*.tgz
.cello-key-tmp-*
.claude/worktrees/

# Renamed out of iCloud sync (".nosync" is skipped by iCloud Drive).
# node_modules is a symlink to this.
node_modules.nosync/

# 037-SESSIONCORE extraction scripts. Throwaway, rebuilt per use, and NEVER shipped — a review
# flagged that seven of them sat untracked at the repo root where one `git add -A` would have
# committed them into a published package.
gf-*.mjs

# iCloud exclusion twin for build output — see scripts/nosync-build-output.sh
dist.nosync/

# Compiled output that lands NEXT TO the source it was built from. The sibling repo had four of
# these committed for one file, and they were a live landmine rather than clutter: every import is
# written `./thing.js`, so once a `.js` exists beside `thing.ts` the test runner resolves to the
# COMPILED copy and the TypeScript is ignored. It matched when committed, so nothing went red — and
# then the first edit to that source silently did nothing at all. Nothing like this is tracked here
# today; the rule is so it stays that way. Build output belongs in dist/.
core/*/src/**/*.js
core/*/src/**/*.js.map
core/*/src/**/*.d.ts
core/*/src/**/*.d.ts.map
