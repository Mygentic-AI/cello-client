{
  "name": "@cello-protocol/crypto",
  "version": "0.0.107-m9d.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./frost/frost-threshold-signer.js": {
      "import": "./dist/frost/frost-threshold-signer.js",
      "types": "./dist/frost/frost-threshold-signer.d.ts"
    },
    "./frost/stubs.js": {
      "import": "./dist/frost/stubs.js",
      "types": "./dist/frost/stubs.d.ts"
    },
    "./frost/types.js": {
      "import": "./dist/frost/types.js",
      "types": "./dist/frost/types.d.ts"
    }
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "preinstall": "node -e \"var v=process.versions.node.split('.').map(Number);if(v[0]<24||(v[0]===24&&v[1]<7)){console.error('@cello-protocol/crypto needs Node >= 24.7 (ML-KEM and ML-DSA are built into node:crypto from 24.7). You have '+process.version+'.');process.exit(1)}\"",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@claude-flow/testing": "3.0.0-alpha.6",
    "@types/node": "^25.6.2"
  }
}
