{
  "name": "@cello-protocol/cli",
  "version": "0.0.38",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "cello": "./dist/bin/cello.js"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@cello-protocol/daemon": "workspace:*",
    "@cello-protocol/protocol-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2"
  }
}
