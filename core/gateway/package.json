{
  "name": "@cello-protocol/gateway",
  "version": "0.0.47",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./detect": {
      "import": "./dist/detect/index.js",
      "types": "./dist/detect/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cello-gateway": "./dist/bin/cello-gateway.js"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "re2-wasm": "^1.0.2"
  },
  "optionalDependencies": {
    "@signalapp/sqlcipher": "^3.3.5",
    "re2": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.22.4"
  }
}
