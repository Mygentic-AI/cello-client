{
  "name": "@cello-protocol/daemon",
  "version": "0.0.98",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cello-daemon": "./dist/bin/cello-daemon.js"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@cello-protocol/crypto": "workspace:*",
    "@cello-protocol/gateway": "workspace:*",
    "@cello-protocol/protocol-types": "workspace:*",
    "@cello-protocol/transport": "workspace:*",
    "@libp2p/interface": "^3.0.0",
    "@signalapp/sqlcipher": "^3.3.5",
    "cbor-x": "^1.6.0",
    "it-length-prefixed": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.22.4"
  }
}
